# ==============================================================================
# Aarogya-Vāyu: Climate-Resilient Rural Health Supply Chain Intelligence
# Environment Configuration Template
# ==============================================================================

# Google Cloud & Gemini API Configuration
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Cloud Project Configuration (Optional for Cloud Run / Vertex AI deployment)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# Gemini Model Selection
DEFAULT_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite

# Anthropic Claude (fallback only; used when Gemini is unavailable)
# Get a key from the Claude Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-5-5

# Application Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Optional: NASA FIRMS fire detections (free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
# 1 = dashboard follows live Open-Meteo/CAMS telemetry by default (0 = start on scenario presets)
LIVE_TELEMETRY_DEFAULT=1
